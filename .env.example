# Copy this file to .env and fill it in.

# How emails are read (both are free):
#   ollama = a free AI model running on your own computer (reads any receipt format)
#   rules  = fixed text rules, no AI (fastest, but misses unusual receipts)
READER=ollama

# Ollama model to use. Download it first with:  ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434

# Where receipts go: "excel" (an Expenses.xlsx file in a folder you choose)
# or "sheets" (a Google Sheet)
OUTPUT=excel
# Folder for Expenses.xlsx. Leave empty: the first run opens a window to choose it.
# (Change it any time with:  python -m receipt_agent --choose-folder)
OUTPUT_FOLDER=
# Google Sheet to write to (its link or ID). Leave empty and the first run creates one for you.
GOOGLE_SHEET_ID=
# Optional: exact Excel file path instead of OUTPUT_FOLDER
# EXCEL_PATH=

# Which inboxes to check
GMAIL_ENABLED=true
OUTLOOK_ENABLED=false
# Needed for Outlook: the "Application (client) ID" of your Azure app (see README)
OUTLOOK_CLIENT_ID=

# How often to check automatically, in minutes (e.g. 60 = every hour).
# 0 = check once and stop, so you run it yourself whenever you want.
CHECK_EVERY_MINUTES=0

# How many days back to look on each run
LOOKBACK_DAYS=30

# Optional
# GMAIL_QUERY=(receipt OR order OR invoice) -category:promotions
# OUTLOOK_AUTHORITY=common          # use "consumers" for personal accounts only
# GOOGLE_CREDENTIALS_FILE=credentials.json
