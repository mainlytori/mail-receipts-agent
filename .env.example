# Copy this file to .env and fill it in.

# How emails are read:
#   claude = Claude AI reads each receipt (accurate, costs a little per email)
#   rules  = fixed text rules, no AI (free, but misses unusual receipts)
READER=claude

# Your Claude API key, from https://platform.claude.com/settings/keys (only for READER=claude)
ANTHROPIC_API_KEY=
# Claude model: claude-haiku-5-5 (cheapest) or claude-opus-5-5 (most accurate, ~40x the cost)
CLAUDE_MODEL=claude-haiku-5-5

# Where receipts go: "sheets" (Google Sheets) or "excel" (a .xlsx file)
OUTPUT=sheets
# Google Sheet to write to. Leave empty and the first run creates one for you.
GOOGLE_SHEET_ID=
# Excel file, used when OUTPUT=excel
EXCEL_PATH=expenses.xlsx

# Which inboxes to check
GMAIL_ENABLED=true
OUTLOOK_ENABLED=false
# Needed for Outlook: the "Application (client) ID" of your Azure app (see README)
OUTLOOK_CLIENT_ID=

# How often to check automatically, in minutes (e.g. 60 = every hour).
# 0 = check once and stop, so you run it yourself whenever you want.
CHECK_EVERY_MINUTES=0

# How many days back to look on each run
LOOKBACK_DAYS=30

# Optional
# GMAIL_QUERY=(receipt OR order OR invoice) -category:promotions
# OUTLOOK_AUTHORITY=common          # use "consumers" for personal accounts only
# GOOGLE_CREDENTIALS_FILE=credentials.json
